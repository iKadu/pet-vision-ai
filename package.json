{
  "name": "tccpet",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"WEB,PYTHON\" -c \"cyan,magenta\" \"npm run dev:web\" \"npm run dev:ai\"",
    "dev:web": "turbo run dev -F web --",
    "dev:ai": "cd apps/ai-engine && .venv\\Scripts\\python.exe -m uvicorn main:app --reload --port 8000",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "db:push": "turbo run db:push -F @tccpet/db --",
    "db:studio": "turbo run db:studio -F @tccpet/db --",
    "db:generate": "turbo run db:generate -F @tccpet/db --",
    "db:migrate": "turbo run db:migrate -F @tccpet/db --",
    "db:start": "turbo run db:start -F @tccpet/db --",
    "db:watch": "turbo run db:watch -F @tccpet/db --",
    "db:stop": "turbo run db:stop -F @tccpet/db --",
    "db:down": "turbo run db:down -F @tccpet/db --",
    "evaluate:identification": "tsx scripts/evaluate-pet-identification.ts"
  },
  "dependencies": {
    "@tccpet/env": "*",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tccpet/config": "*",
    "@types/node": "^22.20.1",
    "concurrently": "^8.2.2",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  }
}
