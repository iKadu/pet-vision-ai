# Local webcam (the numeric value is converted to integer 0)
CAMERA_SOURCE=0

# Inferência/tracking e preview são independentes. O preview pode chegar a 30 FPS.
STREAM_TARGET_FPS=2
STREAM_PREVIEW_FPS=15

# IP camera example (replace credentials and address)
# CAMERA_SOURCE="rtsp://admin:password@192.168.1.100:554/stream1"

# Optional URL used for presence event webhooks
NEXTJS_WEBHOOK_URL=http://localhost:3000/api/webhooks/detection
