# Banco local iniciado por `npm run db:start`.
DATABASE_URL=postgresql://postgres:password@localhost:5433/tccpet

# Gere um segredo único com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=substitua-por-um-segredo-com-no-minimo-32-caracteres
BETTER_AUTH_URL=http://localhost:3001

# URL do motor de IA local. É usada pelo servidor web para gerar embeddings.
AI_ENGINE_URL=http://127.0.0.1:8000

# Use o mesmo valor em apps/ai-engine/.env para autenticar os webhooks do motor.
AI_WEBHOOK_SECRET=substitua-por-um-segredo-compartilhado

# Critérios iniciais de identificação. Só altere após avaliar a base de imagens.
PET_MATCH_MIN_SIMILARITY=0.75
PET_MATCH_MIN_MARGIN=0.05
